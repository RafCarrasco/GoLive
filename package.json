{
  "name": "nimbo",
  "productName": "Nimbo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "npm run desktop:audio && electron desktop/main.cjs",
    "desktop:pack": "npm run desktop:audio && electron-builder --win portable",
    "rules:build": "node scripts/build-rules.mjs",
    "test:rules": "firebase emulators:exec --only database --project demo-nimbo \"node --test tests/rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,database --project demo-nimbo",
    "dev:local": "vite --mode emulator",
    "emulator:approve": "node scripts/emulator-approve.mjs",
    "desktop:audio": "node scripts/build-desktop-audio.mjs",
    "desktop:icon": "electron scripts/desktop-icon.cjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "vite": "^6.2.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.nimbo.desktop",
    "productName": "Nimbo",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "!desktop/native/**",
      "!desktop/bin/**",
      "!desktop/README.md",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "desktop/bin/nimbo-audio.exe",
        "to": "nimbo-audio.exe"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "Nimbo-Portable.exe"
    }
  },
  "description": "Nimbo: comunidade privada para lives de tela e webcam entre amigos",
  "author": "Rafael Carrasco"
}
